<?xml version="1.0" encoding="utf-8"?>
<!-- Widget «Cuenta atrás de vacaciones» (2×1). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/tw_raiz" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/tt_widget_fondo" android:orientation="horizontal" android:padding="12dp" android:gravity="center_vertical">
<TextView android:id="@+id/tw_num" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#38BDF8" android:textSize="30sp" android:textStyle="bold" android:layout_marginRight="10dp"/>
<LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
<TextView android:id="@+id/tw_l1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#CBD5E1" android:textSize="11sp" android:maxLines="1"/>
<TextView android:id="@+id/tw_l2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#F8FAFC" android:textSize="12.5sp" android:textStyle="bold" android:maxLines="1"/>
<TextView android:id="@+id/tw_l3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#94A3B8" android:textSize="10.5sp" android:maxLines="1"/>
</LinearLayout>
</LinearLayout>
