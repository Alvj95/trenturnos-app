<?xml version="1.0" encoding="utf-8"?>
<!-- Widget «Próximos turnos» (4×2): hoy y los 3 días siguientes. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tt_raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/tt_widget_fondo"
    android:orientation="vertical"
    android:padding="10dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Próximos turnos"
            android:textColor="#F8FAFC"
            android:textSize="14sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🚆 TRENTURNOS"
            android:textColor="#94A3B8"
            android:textSize="9sp"
            android:textStyle="bold" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/tt_p0"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/tt_pd0"
            android:layout_width="58dp"
            android:layout_height="wrap_content"
            android:textColor="#94A3B8"
            android:textSize="10.5sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/tt_pc0"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/tt_cel_nada"
            android:paddingLeft="7dp"
            android:paddingTop="2dp"
            android:paddingRight="7dp"
            android:paddingBottom="2dp"
            android:textColor="#CBD5E1"
            android:textSize="10sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/tt_pt0"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#E2E8F0"
            android:textSize="11.5sp" />
        <TextView
            android:id="@+id/tt_ph0"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:textColor="#FCD34D"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/tt_p1"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/tt_pd1"
            android:layout_width="58dp"
            android:layout_height="wrap_content"
            android:textColor="#94A3B8"
            android:textSize="10.5sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/tt_pc1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/tt_cel_nada"
            android:paddingLeft="7dp"
            android:paddingTop="2dp"
            android:paddingRight="7dp"
            android:paddingBottom="2dp"
            android:textColor="#CBD5E1"
            android:textSize="10sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/tt_pt1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#E2E8F0"
            android:textSize="11.5sp" />
        <TextView
            android:id="@+id/tt_ph1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:textColor="#FCD34D"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/tt_p2"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/tt_pd2"
            android:layout_width="58dp"
            android:layout_height="wrap_content"
            android:textColor="#94A3B8"
            android:textSize="10.5sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/tt_pc2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/tt_cel_nada"
            android:paddingLeft="7dp"
            android:paddingTop="2dp"
            android:paddingRight="7dp"
            android:paddingBottom="2dp"
            android:textColor="#CBD5E1"
            android:textSize="10sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/tt_pt2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#E2E8F0"
            android:textSize="11.5sp" />
        <TextView
            android:id="@+id/tt_ph2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:textColor="#FCD34D"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/tt_p3"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/tt_pd3"
            android:layout_width="58dp"
            android:layout_height="wrap_content"
            android:textColor="#94A3B8"
            android:textSize="10.5sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/tt_pc3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/tt_cel_nada"
            android:paddingLeft="7dp"
            android:paddingTop="2dp"
            android:paddingRight="7dp"
            android:paddingBottom="2dp"
            android:textColor="#CBD5E1"
            android:textSize="10sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/tt_pt3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#E2E8F0"
            android:textSize="11.5sp" />
        <TextView
            android:id="@+id/tt_ph3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:textColor="#FCD34D"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
