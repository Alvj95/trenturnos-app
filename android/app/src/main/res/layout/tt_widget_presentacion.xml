<?xml version="1.0" encoding="utf-8"?>
<!-- Widget «Próxima presentación» (2×1): cuenta atrás hasta presentarte. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/tw_raiz" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/tt_widget_fondo" android:orientation="vertical" android:padding="12dp" android:gravity="center_vertical">
<TextView android:id="@+id/tw_tit" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#94A3B8" android:textSize="10.5sp" android:textStyle="bold" android:text="TE PRESENTAS EN"/>
<Chronometer android:id="@+id/tw_crono" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FCD34D" android:textSize="22sp" android:textStyle="bold"/>
<TextView android:id="@+id/tw_dias" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FCD34D" android:textSize="22sp" android:textStyle="bold" android:visibility="gone"/>
<TextView android:id="@+id/tw_donde" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#CBD5E1" android:textSize="11.5sp" android:maxLines="1"/>
</LinearLayout>
